# 悟码AI网页侧默认使用腾讯混元；LearnBuddy侧模型由赛事平台提供
LLM_PROVIDER=hunyuan
LLM_PROVIDER_NAME=腾讯混元

# 当前版本支持OpenAI兼容接口
LLM_API_STYLE=openai-compatible
LLM_API_KEY=请替换为你自己的密钥
LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
LLM_MODEL=hunyuan-turbos-latest

# 若官方模型不支持response_format，请改为false
LLM_JSON_MODE=false

# 教师端登录密码。请自行设置，不要把真实密码提交到代码仓库
TEACHER_PASSWORD=

# 赛事浏览器Demo：启用后提供免密码体验入口并自动生成合成数据
WUMA_DEMO_MODE=false
WUMA_DEMO_READ_ONLY=true

# 可选：指定数据库路径。在线Demo建议使用临时或独立数据库
# WUMA_AI_DB_PATH=/tmp/wuma_ai_demo.db

# 历史版本的模型变量仍可用于迁移；赛事展示请使用上方腾讯混元配置

# 代码执行总开关。关闭时仍可继续AI静态分析和答辩
CODE_EXECUTION_ENABLED=false

# local兼容原来的本机g++模式；docker使用隔离容器（推荐用于演示部署）
CODE_EXECUTION_BACKEND=local
CXX_COMPILER=g++

# Docker模式需先启动Docker Desktop并执行：docker pull gcc:13-bookworm
DOCKER_COMMAND=docker
DOCKER_CPP_IMAGE=gcc:13-bookworm

CODE_EXECUTION_TIMEOUT_SECONDS=2
CODE_COMPILE_TIMEOUT_SECONDS=15
CODE_EXECUTION_MAX_OUTPUT_CHARS=4000
